<?xml version="1.0"?>
<robot name="my_diff_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="enable_gz_control" default="false"/>

    <ros2_control name="DiffMobileRobotHWInterface" type="system">
        <hardware>
            <xacro:if value="$(arg enable_gz_control)">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:if>
            <xacro:unless value="$(arg enable_gz_control)">
                <plugin>mock_components/GenericSystem</plugin>
            </xacro:unless>
            <param name="calculate_dynamics" >true</param>
        </hardware>

        <!-- Command and State interfaces -->
        <joint name="base_right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

        <joint name="base_left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
        </joint>

    </ros2_control>

</robot>