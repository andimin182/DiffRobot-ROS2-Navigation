<?xml version="1.0"?>
<robot name="my_diff_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="prefix" default=""/>
    <xacro:property name="M_PI" value="3.1415926535897931" />
    <xacro:arg name="enable_collision" default="false"/>

    <xacro:include filename="$(find diff_robot_description)/urdf/sensors/imu.urdf.xacro" />
    <xacro:include filename="$(find diff_robot_description)/urdf/sensors/lidar.urdf.xacro" />
    <xacro:include filename="$(find diff_robot_description)/urdf/sensors/rgbd_camera.urdf.xacro" />


<!--
    <xacro:rgbd_camera
      prefix="$(arg prefix)"
      camera_name="cam_1"
      xyz_offset="0.105 0 0.05"
      rpy_offset="0 -0.50 0"/>

    <xacro:imu_sensor
      prefix="$(arg prefix)"
      parent="base_link"
      frame_id="imu"
      xyz_offset="0 0 0.006"
      rpy_offset="0 0 0"
      update_rate="15.0"
      topic_name="imu/data"/> -->

      <xacro:lidar_sensor
        prefix="$(arg prefix)"
        parent="base_link"
        frame_id="base_scan"
        xyz_offset="0 0 0.23"
        rpy_offset="0 0 0"
        enable_collision="$(arg enable_collision)"
        topic_name="scan"/>


</robot>